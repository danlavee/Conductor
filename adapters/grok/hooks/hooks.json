{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "new|load",
        "hooks": [
          {
            "type": "command",
            "command": "${CONDUCTOR_BIN}",
            "args": ["adapter", "grok", "identity", "--session=${GROK_SESSION_ID}"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CONDUCTOR_BIN}",
            "args": ["adapter", "grok", "reannounce", "--session=${GROK_SESSION_ID}"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CONDUCTOR_BIN}",
            "args": ["adapter", "grok", "stop", "--session=${GROK_SESSION_ID}"],
            "timeout": 86400
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CONDUCTOR_BIN}",
            "args": ["adapter", "grok", "release", "--session=${GROK_SESSION_ID}"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
